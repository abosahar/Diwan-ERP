# «الديوان» on an office's own computer (Windows, Mac or Linux desktop).
# Written by deploy/windows/install.ps1, deploy/mac/install.sh and
# deploy/linux/install.sh: they fill the __PLACEHOLDERS__ below.
APP_NAME="الديوان"
APP_NAME_EN=Diwan
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:__PORT__
APP_DOMAIN=localhost
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# First visit creates the company (/setup); accounts need no email verification.
DIWAN_LOCAL_INSTALL=true
# Plain HTTP on the office network, reached by this computer's IP or name.
FORCE_HTTPS=false
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=
TENANCY_REJECT_UNKNOWN_HOSTS=false
TENANCY_ENFORCE_SUBDOMAIN=false
TENANCY_ALLOW_DEV_OVERRIDE=false
DEMO_LOGIN=false

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=__DB_PORT__
DB_DATABASE=diwan
DB_USERNAME=diwan
DB_PASSWORD=__DB_PASSWORD__

# No Redis on a personal computer: sessions, cache and queues in the database.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database
CACHE_STORE=database

# No mail by default (fill these later to email invoices to customers).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@diwan.local
MAIL_FROM_NAME="${APP_NAME}"

# Nightly encrypted backups into storage/app/backups.
BACKUP_PASSWORD=__BACKUP_PASSWORD__
BACKUP_MYSQLDUMP=__MYSQLDUMP__
BACKUP_MYSQL=__MYSQL__

HEALTH_CHECK_OPERATIONS=true
VITE_APP_NAME="${APP_NAME}"
